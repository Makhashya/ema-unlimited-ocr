# Copy this file to `.env` (same folder) and fill in what you use.
# `.env` is gitignored -- your keys never leave this machine.
# vlm_to_md.py reads it at startup; real environment variables win over
# values in this file, and command-line flags win over both.

# --- API keys (fill in only the provider(s) you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Key for --provider custom (optional; leave empty for keyless local servers)
API_KEY=

# --- Default endpoint (optional) ---
# Set these to skip typing --provider/--model/--base-url every run.
# VLM_PROVIDER: openai | anthropic | gemini | custom
VLM_PROVIDER=
# VLM_MODEL: overrides the provider's preset model, e.g. gpt-4o, claude-opus-5
VLM_MODEL=
# VLM_BASE_URL: only needed for custom endpoints, e.g. http://127.0.0.1:8000/v1
VLM_BASE_URL=
# VLM_API_KEY_ENV: read the key from a different variable name than the preset
VLM_API_KEY_ENV=

# --- Web UI (app.py / app_jobs.py) ---
# Sign-in password required by the page when set. Set it before
# exposing the app on a public URL (serve_public.py refuses without it).
APP_PASSWORD=
# Fixed public URL for serve_public.py / run_server.bat: your free static
# ngrok domain (dashboard.ngrok.com -> Domains). Blank = random Cloudflare URL.
NGROK_DOMAIN=
