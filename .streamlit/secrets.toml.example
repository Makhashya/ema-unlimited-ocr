# Secrets for the hosted app. Same names as .env.
#
#   Streamlit Community Cloud: paste the filled-in contents into the app's
#   Settings -> Secrets. Never commit the real values.
#   Local testing: copy to .streamlit/secrets.toml (gitignored).
#
# app.py copies these into the environment, so anything from .env.example
# works here too (VLM_MODEL, VLM_BASE_URL, VLM_API_KEY_ENV, ...).

# Required before exposing the app publicly: the sign-in password.
APP_PASSWORD = "choose-a-long-password"

# Default backend: openai | anthropic | gemini | custom
VLM_PROVIDER = "openai"
# VLM_MODEL = "gpt-4o"

# Fill in only the provider(s) you use.
OPENAI_API_KEY = ""
ANTHROPIC_API_KEY = ""
GEMINI_API_KEY = ""
